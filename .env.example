# Safe defaults: read-only stdio MCP
LINE_MCP_ALLOW_SEND=false
LINE_MCP_ALLOW_AUTO_SEND=false
LINE_MCP_ALLOW_HTTP=false

# Required only when local HTTP mode is explicitly enabled.
# Use a long random value (24+ characters) and keep it out of git.
LINE_MCP_HTTP_TOKEN=

# Optional local chat logging. Leave disabled unless you intentionally want plaintext logs.
CHAT_LOG_ON=false
CHAT_LOG_PATH=
