{
  "name": "line-desktop-mcp-safe",
  "version": "1.1.2-safe.1",
  "description": "Hardened, read-only-by-default fork of LINE Desktop MCP GUI automation",
  "main": "./src/server.js",
  "bin": {
    "line-desktop-mcp-safe": "./src/server.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/test.js",
    "security:syntax": "node --check src/server.js",
    "build:mcpb": "node scripts/build-mcpb.js"
  },
  "keywords": [
    "mcp",
    "line",
    "automation",
    "gui",
    "desktop",
    "security",
    "read-only"
  ],
  "author": "Geoffrey Wang",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "applescript": "^1.0.0",
    "archiver": "^7.0.1",
    "chardet": "^2.1.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32",
    "darwin"
  ],
  "files": [
    "src/**/*",
    "SECURITY.md",
    "SAFE_FORK.md",
    ".env.example"
  ]
}
