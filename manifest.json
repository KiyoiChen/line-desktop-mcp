{
  "manifest_version": "0.2",
  "name": "line-desktop-mcp-safe",
  "display_name": "LINE Desktop MCP Safe",
  "version": "1.1.2-safe.1",
  "description": "Hardened, read-only-by-default LINE Desktop MCP fork",
  "author": {
    "name": "Geoffrey Wang (upstream), hardened fork maintained by KiyoiChen",
    "url": "https://github.com/KiyoiChen/line-desktop-mcp"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KiyoiChen/line-desktop-mcp"
  },
  "homepage": "https://github.com/KiyoiChen/line-desktop-mcp",
  "support": "https://github.com/KiyoiChen/line-desktop-mcp/issues",
  "keywords": [
    "mcp",
    "line",
    "automation",
    "gui",
    "desktop",
    "security",
    "read-only"
  ],
  "server": {
    "type": "node",
    "entry_point": "src/server.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "src/server.js"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
